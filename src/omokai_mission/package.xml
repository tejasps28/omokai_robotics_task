  <version>0.1.0</version>
  <description>Mission validation, route compilation, and planner abstraction for the Omokai core pipeline.</description>
  <maintainer email="tejasps28@gmail.com">Tejas</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>omokai_interfaces</exec_depend>
  <exec_depend>python3-jsonschema</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
