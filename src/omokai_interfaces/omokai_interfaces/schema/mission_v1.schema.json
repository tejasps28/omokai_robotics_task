{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://omokai.example/schemas/mission-v1.schema.json",
  "title": "Omokai Core Mission v1.1",
  "description": "Strict LLM proposal contract for the Task 1 ground-robot pipeline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action",
    "route_id",
    "segments",
    "speed_mps",
    "return_home"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "action": {
      "enum": ["patrol"]
    },
    "route_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "Symbolic audited route: inspection_loop, aisle_sweep, full_area_sweep, or rejected_request when intent is unsupported."
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "description": "Ordered traversal blocks. Preserve requested direction changes in separate items.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["direction", "repetitions"],
        "properties": {
          "direction": {
            "type": "string",
            "description": "inspection_loop uses clockwise/counterclockwise; aisle_sweep uses forward/reverse.",
            "enum": [
              "clockwise",
              "counterclockwise",
              "forward",
              "reverse"
            ]
          },
          "repetitions": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "speed_mps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "return_home": {
      "type": "boolean"
    }
  }
}
