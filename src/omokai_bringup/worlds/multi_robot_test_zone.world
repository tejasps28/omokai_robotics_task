<?xml version="1.0"?>
<sdf version="1.8">
  <world name="multi_robot_test_zone">
    <physics name="fast" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>24 24</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>24 24</size></plane></geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.72 0.72 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Harmonic validates inertia even on this upstream static model. The
         original SDF has a zero inertia tensor, so declare the unchanged mesh
         as a static local model and omit inertial data. -->
    <model name="test_zone">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>-8.12 8.8 0 1.57 0 0</pose>
          <geometry>
            <mesh><uri>model://test_zone/meshes/building.dae</uri></mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>-8.12 8.8 0 1.57 0 0</pose>
          <geometry>
            <mesh><uri>model://test_zone/meshes/building.dae</uri></mesh>
          </geometry>
        </visual>
      </link>
    </model>
  </world>
</sdf>
