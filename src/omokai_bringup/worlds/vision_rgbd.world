<?xml version="1.0"?>
<!--
  Minimal Gazebo Harmonic adaptation of the office_small layout from
  leonhartyao/gazebo_models_worlds_collection at
  cce115b82691b7c529a02f47e5efa391145a4ca1 (GPL-3.0).
  Furniture and decorative assets are intentionally omitted for a clear
  perception/search/follow demonstration. See models/office_small_collection/
  SOURCE.md and LICENSE.GPL-3.0.
-->
<sdf version="1.9">
  <world name="vision_rgbd">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>
    <physics name="default_physics" default="1" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.78 0.82 0.88 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.5 0.4 -1</direction>
    </light>

    <!-- Clear 10 x 10 m office shell derived from office_small. -->
    <model name="office_small_minimal">
      <static>true</static>
      <link name="shell">
        <collision name="floor_collision">
          <pose>0 0 0.01 0 0 0</pose>
          <geometry><box><size>10 10 0.02</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="floor_visual">
          <pose>0 0 0.01 0 0 0</pose>
          <geometry><box><size>10 10 0.02</size></box></geometry>
          <material>
            <ambient>0.58 0.60 0.63 1</ambient>
            <diffuse>0.58 0.60 0.63 1</diffuse>
            <specular>0.04 0.04 0.04 1</specular>
          </material>
        </visual>

        <collision name="north_wall_collision">
          <pose>0 5 1.25 0 0 0</pose>
          <geometry><box><size>10 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="north_wall_visual">
          <pose>0 5 1.25 0 0 0</pose>
          <geometry><box><size>10 0.15 2.5</size></box></geometry>
          <material><ambient>0.88 0.88 0.84 1</ambient><diffuse>0.88 0.88 0.84 1</diffuse></material>
        </visual>

        <collision name="south_wall_collision">
          <pose>0 -5 1.25 0 0 0</pose>
          <geometry><box><size>10 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="south_wall_visual">
          <pose>0 -5 1.25 0 0 0</pose>
          <geometry><box><size>10 0.15 2.5</size></box></geometry>
          <material><ambient>0.88 0.88 0.84 1</ambient><diffuse>0.88 0.88 0.84 1</diffuse></material>
        </visual>

        <collision name="east_wall_collision">
          <pose>5 0 1.25 0 0 0</pose>
          <geometry><box><size>0.15 10 2.5</size></box></geometry>
        </collision>
        <visual name="east_wall_visual">
          <pose>5 0 1.25 0 0 0</pose>
          <geometry><box><size>0.15 10 2.5</size></box></geometry>
          <material><ambient>0.82 0.86 0.90 1</ambient><diffuse>0.82 0.86 0.90 1</diffuse></material>
        </visual>

        <collision name="west_wall_collision">
          <pose>-5 0 1.25 0 0 0</pose>
          <geometry><box><size>0.15 10 2.5</size></box></geometry>
        </collision>
        <visual name="west_wall_visual">
          <pose>-5 0 1.25 0 0 0</pose>
          <geometry><box><size>0.15 10 2.5</size></box></geometry>
          <material><ambient>0.82 0.86 0.90 1</ambient><diffuse>0.82 0.86 0.90 1</diffuse></material>
        </visual>

        <!-- One short partition keeps an office character without cluttering
             the robot/actor corridor in the southern half of the room. -->
        <collision name="partition_collision">
          <pose>1.8 1.8 0.9 0 0 0</pose>
          <geometry><box><size>3.6 0.12 1.8</size></box></geometry>
        </collision>
        <visual name="partition_visual">
          <pose>1.8 1.8 0.9 0 0 0</pose>
          <geometry><box><size>3.6 0.12 1.8</size></box></geometry>
          <material><ambient>0.35 0.55 0.70 1</ambient><diffuse>0.35 0.55 0.70 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- The launch file spawns either the controlled moving target or the
         frozen stationary regression target from the same pinned skin. -->
  </world>
</sdf>
